@prefix eos:  <https://example.org/engineering-os/metamodel#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

#
# Engineering OS Metamodel — Semantic Layer A
#
# STATUS: skeleton. Covers the 22 of 28 Layer A entities specified so far.
# Generated by hand from model/metamodel/entities/*.md. Not compiler output.
#
# NAMESPACE IS A PLACEHOLDER. example.org is IANA-reserved for exactly this
# purpose. The production namespace is an open decision — see FINDINGS.md.
#

<https://example.org/engineering-os/metamodel>
    a owl:Ontology ;
    dct:title "Engineering OS Metamodel" ;
    dct:description "Semantic Layer A: the language in which repository knowledge models are expressed." ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    owl:versionIRI <https://example.org/engineering-os/metamodel/0.3.0> ;
    owl:versionInfo "0.3.0-skeleton" ;
    rdfs:comment "Incomplete by construction: 22 of 28 entities. Ranges pointing at unspecified entities are omitted rather than guessed. eos:StateMachine is retained despite failing the ADR-0067 test, pending the simplification review (ISSUE-0074)." .


###############################################################################
# Top-level families — ADR-0065
###############################################################################

eos:MetamodelEntity
    a owl:Class ;
    rdfs:label "Metamodel Entity" ;
    rdfs:comment "Any Layer A entity. Abstract: every instance belongs to exactly one family." .

eos:DescriptiveEntity
    a owl:Class ;
    rdfs:subClassOf eos:MetamodelEntity ;
    rdfs:label "Descriptive Entity" ;
    rdfs:comment "Describes knowledge: what is true of the modelled world. Owned by a BoundedContext. Meaningful in a repository with no engineering process." .

eos:OperationalEntity
    a owl:Class ;
    rdfs:subClassOf eos:MetamodelEntity ;
    rdfs:label "Operational Entity" ;
    rdfs:comment "Describes engineering activity: what was done, decided, or must be done. Owned by the engineering process. Meaningless without one." .

[] a owl:AllDisjointClasses ;
   owl:members ( eos:DescriptiveEntity eos:OperationalEntity ) .


###############################################################################
# ContextualEntity — NOT in the Markdown specifications.
#
# Introduced here because Concept, Capability, Invariant and Actor each declare
# an identical "qualified name within a BoundedContext" identity and an
# identical scopedTo relationship. In OWL that repetition is a missing
# superclass. See FINDINGS.md #3.
###############################################################################

eos:ContextualEntity
    a owl:Class ;
    rdfs:subClassOf eos:DescriptiveEntity ;
    rdfs:label "Contextual Entity" ;
    rdfs:comment "A descriptive entity whose identity is a qualified name within exactly one BoundedContext." ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty eos:scopedTo ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .


###############################################################################
# Descriptive entities — the semantic backbone
###############################################################################

eos:BoundedContext
    a owl:Class ;
    rdfs:subClassOf eos:DescriptiveEntity ;
    rdfs:label "Bounded Context" ;
    rdfs:comment "A boundary within which a set of terms has one consistent meaning. What makes two identical names non-conflicting." .

eos:Concept
    a owl:Class ;
    rdfs:subClassOf eos:ContextualEntity ;
    rdfs:label "Concept" ;
    rdfs:comment "A named unit of meaning within a bounded context." .

eos:Capability
    a owl:Class ;
    rdfs:subClassOf eos:ContextualEntity ;
    rdfs:label "Capability" ;
    rdfs:comment "Something a system can do, externally visible. A capability with no realisation is a legitimate state." .

eos:Invariant
    a owl:Class ;
    rdfs:subClassOf eos:ContextualEntity ;
    rdfs:label "Invariant" ;
    rdfs:comment "A condition that must hold, stated independently of whatever enforces it. An invariant with no enforcement point is a result, not an error." .

eos:Actor
    a owl:Class ;
    rdfs:subClassOf eos:ContextualEntity ;
    rdfs:label "Actor" ;
    rdfs:comment "A role that interacts with a system's Capabilities. A role, not a party; may be filled by a human, a system or an agent." .

eos:RelationshipType
    a owl:Class ;
    rdfs:subClassOf eos:ContextualEntity ;
    rdfs:label "Relationship Type" ;
    rdfs:comment "A declaration that a kind of association may exist, and what it means: domain, range, cardinality, constraints, semantics. The metamodel defines the VOCABULARY of relationships and does not represent every edge as an entity (ADR-0066). Instances are graph structure, compiled to owl:ObjectProperty — they are not instances of this class." ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eos:hasDomain ; owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] , [
        a owl:Restriction ; owl:onProperty eos:hasRange ; owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

eos:Evidence
    a owl:Class ;
    rdfs:subClassOf eos:DescriptiveEntity ;
    rdfs:label "Evidence" ;
    rdfs:comment "A reference to an observable fact, cited in support of an assertion. Does not make an assertion true; makes it falsifiable." .

eos:EvidenceKind
    a owl:Class ;
    rdfs:label "Evidence Kind" ;
    rdfs:comment "Registered vocabulary, ordered by directness. Not a closed list." .

eos:RuntimeObservation  a eos:EvidenceKind ; rdfs:label "Runtime observation" ; eos:directnessRank 1 .
eos:SourceReference     a eos:EvidenceKind ; rdfs:label "Source reference"     ; eos:directnessRank 2 .
eos:ArtifactReference   a eos:EvidenceKind ; rdfs:label "Artifact reference"   ; eos:directnessRank 3 .
eos:ExternalReference   a eos:EvidenceKind ; rdfs:label "External reference"   ; eos:directnessRank 4 .
eos:Inference           a eos:EvidenceKind ; rdfs:label "Inference"            ; eos:directnessRank 5 ;
    rdfs:comment "The weakest kind. Must be marked as such: evidence that does not distinguish observation from inference lets a chain of guesses look like a chain of facts." .


###############################################################################
# Descriptive entities — artifacts and classification
###############################################################################

eos:Artifact
    a owl:Class ;
    rdfs:subClassOf eos:DescriptiveEntity ;
    rdfs:label "Artifact" ;
    rdfs:comment "A stable logical identity that owns many revisions. Has NO lifecycle of its own — 'what state is this artifact in?' is a malformed question." ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty eos:hasActiveRevision ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

eos:ArtifactRevision
    a owl:Class ;
    rdfs:subClassOf eos:DescriptiveEntity ;
    rdfs:label "Artifact Revision" ;
    rdfs:comment "An immutable revision. The unit that is accepted and the unit that carries lifecycle state. Identity is the pair (artifact-id, revision-id); a Git SHA is provenance, not identity." ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty eos:revisionOf ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .

eos:DimensionSpecification
    a owl:Class ;
    rdfs:subClassOf eos:DescriptiveEntity ;
    rdfs:label "Dimension Specification" ;
    rdfs:comment "Defines one independent axis of classification. Ten required fields per ADR-0048." .

eos:Dimension
    a owl:Class ;
    rdfs:subClassOf eos:DescriptiveEntity ;
    rdfs:label "Dimension" ;
    rdfs:comment "An independent axis of classification. See FINDINGS.md #2 — in OWL this class carries no data its specification does not already carry." ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty eos:specifiedBy ;
        owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .

eos:DimensionAssignment
    a owl:Class ;
    rdfs:subClassOf eos:DescriptiveEntity ;
    rdfs:label "Dimension Assignment" ;
    rdfs:comment "The relationship classifying an artifact revision along a dimension. A reified n-ary relation: this is why Relationship is strictly binary." ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eos:classifies ; owl:cardinality "1"^^xsd:nonNegativeInteger
    ] , [
        a owl:Restriction ; owl:onProperty eos:along ; owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .


###############################################################################
# Object properties
###############################################################################

eos:scopedTo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain eos:ContextualEntity ; rdfs:range eos:BoundedContext ;
    rdfs:label "scoped to" .

eos:contains a owl:ObjectProperty ;
    rdfs:domain eos:BoundedContext ; rdfs:range eos:ContextualEntity ;
    owl:inverseOf eos:scopedTo ;
    rdfs:label "contains" ;
    rdfs:comment "Inverse only. Membership is asserted by the member; a context that enumerated its members would be a hand-maintained projection (ISSUE-0037)." .

eos:relatesTo a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain eos:BoundedContext ; rdfs:range eos:BoundedContext ;
    rdfs:label "relates to" ;
    rdfs:comment "Descriptive, never inferential (ADR-0044). Implies nothing about the meaning of terms in either context." .

eos:hasDomain a owl:ObjectProperty ;
    rdfs:domain eos:RelationshipType ; rdfs:range owl:Class ; rdfs:label "has domain" ;
    rdfs:comment "What may be the source. Compiles to rdfs:domain." .

eos:hasRange a owl:ObjectProperty ;
    rdfs:domain eos:RelationshipType ; rdfs:range owl:Class ; rdfs:label "has range" ;
    rdfs:comment "What may be the target. Compiles to rdfs:range." .

eos:constrains a owl:ObjectProperty ;
    rdfs:domain eos:Invariant ; rdfs:label "constrains" .

eos:constrainedBy a owl:ObjectProperty ;
    owl:inverseOf eos:constrains ; rdfs:label "constrained by" .

eos:enforcedAt a owl:ObjectProperty ;
    rdfs:domain eos:Invariant ; rdfs:range eos:Artifact ; rdfs:label "enforced at" ;
    rdfs:comment "Zero or more. The unenforced case is the one worth being able to state." .

eos:realisedBy a owl:ObjectProperty ;
    rdfs:domain eos:Capability ; rdfs:range eos:Artifact ; rdfs:label "realised by" ;
    rdfs:comment "Zero or more. A specified capability with no realisation is a legitimate state." .

eos:uses a owl:ObjectProperty ;
    rdfs:domain eos:Actor ; rdfs:range eos:Capability ; rdfs:label "uses" .

eos:specialises a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( eos:Actor eos:RelationshipType ) ] ;
    rdfs:label "specialises" ;
    rdfs:comment "Single parent by decision, not by derivation. A role that is genuinely two roles is two Actors." .

eos:supports a owl:ObjectProperty ;
    rdfs:domain eos:Evidence ; rdfs:label "supports" ;
    rdfs:comment "Range UNDECLARED. The specification says 'any assertion' and no Assertion class exists. See FINDINGS.md #4." .

eos:evidencedBy a owl:ObjectProperty ;
    owl:inverseOf eos:supports ; rdfs:label "evidenced by" .

eos:references a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain eos:Evidence ; rdfs:label "references" .

eos:observedAt a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain eos:Evidence ; rdfs:range eos:ArtifactRevision ; rdfs:label "observed at" .

eos:ofKind a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain eos:Evidence ; rdfs:range eos:EvidenceKind ; rdfs:label "of kind" .

eos:revisionOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain eos:ArtifactRevision ; rdfs:range eos:Artifact ; rdfs:label "revision of" .

eos:hasRevision a owl:ObjectProperty ;
    owl:inverseOf eos:revisionOf ; rdfs:label "has revision" .

eos:hasActiveRevision a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf eos:hasRevision ;
    rdfs:domain eos:Artifact ; rdfs:range eos:ArtifactRevision ;
    rdfs:label "has active revision" ;
    rdfs:comment "Zero or one, not exactly one." .

eos:specifiedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain eos:Dimension ; rdfs:range eos:DimensionSpecification ; rdfs:label "specified by" .

eos:classifies a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain eos:DimensionAssignment ; rdfs:range eos:ArtifactRevision ; rdfs:label "classifies" .

eos:along a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain eos:DimensionAssignment ; rdfs:range eos:Dimension ; rdfs:label "along" .

eos:hasValue a owl:ObjectProperty ;
    rdfs:domain eos:DimensionAssignment ; rdfs:label "has value" ;
    rdfs:comment "Range is per-Dimension and therefore UNDECLARABLE in plain OWL. See FINDINGS.md #6." .


###############################################################################
# Datatype properties
###############################################################################

eos:artifactId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain eos:Artifact ; rdfs:range xsd:string ; rdfs:label "artifact id" .

eos:revisionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain eos:ArtifactRevision ; rdfs:range xsd:string ; rdfs:label "revision id" ;
    rdfs:comment "Immutable, unique within the Artifact, and must not require Git." .

eos:qualifiedName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain eos:ContextualEntity ; rdfs:range xsd:string ; rdfs:label "qualified name" .

eos:statement a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain eos:Invariant ; rdfs:range xsd:string ; rdfs:label "statement" ;
    rdfs:comment "Natural language is the authoritative form. Most real invariants are not formalisable without losing the part that matters." .

eos:directnessRank a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain eos:EvidenceKind ; rdfs:range xsd:integer ; rdfs:label "directness rank" ;
    rdfs:comment "1 is most direct. Runtime observation outranks source, which outranks documentation, which outranks inference." .


###############################################################################
# Operational entities — ADR-0065
#
# Ranges pointing at unspecified entities (Principle, ValidationRule,
# StateMachine, Vocabulary) are deliberately OMITTED rather than guessed.
###############################################################################

eos:Policy
    a owl:Class ;
    rdfs:subClassOf eos:OperationalEntity ;
    rdfs:label "Policy" ;
    rdfs:comment "A normative rule, motivated by a Principle, governing engineering activity. Distinct from Invariant: an Invariant constrains the modelled world, a Policy constrains the engineering performed on it." .

eos:GovernancePolicy a owl:Class ; rdfs:subClassOf eos:Policy ;
    rdfs:label "Governance Policy" ; rdfs:comment "Governs how decisions are made and recorded." .
eos:ModelingPolicy   a owl:Class ; rdfs:subClassOf eos:Policy ;
    rdfs:label "Modeling Policy"  ; rdfs:comment "Governs how the knowledge model may be shaped." .
eos:ProcessPolicy    a owl:Class ; rdfs:subClassOf eos:Policy ;
    rdfs:label "Process Policy"   ; rdfs:comment "Governs how engineering work is performed." .

[] a owl:AllDisjointClasses ;
   owl:members ( eos:GovernancePolicy eos:ModelingPolicy eos:ProcessPolicy ) .

eos:Skill
    a owl:Class ;
    rdfs:subClassOf eos:OperationalEntity ;
    rdfs:label "Skill" ;
    rdfs:comment "A composable unit of methodology with an explicit contract. The contract is formal; the method is prose and authoritative as prose." ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eos:produces ; owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

eos:Workflow
    a owl:Class ;
    rdfs:subClassOf eos:OperationalEntity ;
    rdfs:label "Workflow" ;
    rdfs:comment "Executable orchestration. Sequences Skills and holds no methodology of its own (ADR-0033). Relates to steps, not directly to skills: the order is extrinsic and therefore lives on the reified association (ADR-0068)." ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eos:hasStep ; owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

eos:EngineeringGate
    a owl:Class ;
    rdfs:subClassOf eos:OperationalEntity ;
    rdfs:label "Engineering Gate" ;
    rdfs:comment "An Engineering Process reviewing the introduction or modification of a concept. Holds the questions (ADR-0055): a question asked of an artifact is asked once; a question held by a Gate is asked every time." .

eos:AcceptanceRecord
    a owl:Class ;
    rdfs:subClassOf eos:OperationalEntity ;
    rdfs:label "Acceptance Record" ;
    rdfs:comment "The act conferring Active status on an ArtifactRevision. The only entity that changes another entity's state. Has NO lifecycle of its own: a record of an act cannot later become a different act. The chain terminates here (ADR-0024)." ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eos:reviewedBy ; owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .

eos:ADR
    a owl:Class ;
    rdfs:subClassOf eos:OperationalEntity ;
    rdfs:label "Architecture Decision Record" ;
    rdfs:comment "A recorded architectural decision. Never edited once accepted: superseded instead. A superseded ADR is not a stale revision, it is a correct record of what was decided then." ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eos:supersededBy ; owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

eos:Issue
    a owl:Class ;
    rdfs:subClassOf eos:OperationalEntity ;
    rdfs:label "Issue" ;
    rdfs:comment "A recorded unknown. The only entity representing ABSENT knowledge; every other entity asserts something. Lifecycle is its own (open/deferred/resolved), not ArtifactRevisionLifecycle: an issue is not accepted, it is answered." .


###############################################################################
# Operational object properties
###############################################################################

eos:motivatedBy a owl:ObjectProperty ;
    rdfs:domain eos:Policy ; rdfs:label "motivated by" ;
    rdfs:comment "Range Principle — UNSPECIFIED entity. This link is what makes Principle -> Policy -> Process -> Artifact a chain (ADR-0056) rather than four unrelated things." .

eos:governs a owl:ObjectProperty ;
    rdfs:domain eos:Policy ; rdfs:label "governs" .

eos:enforcedBy a owl:ObjectProperty ;
    rdfs:domain eos:Policy ; rdfs:label "enforced by" ;
    rdfs:comment "Range ValidationRule — UNSPECIFIED entity. Zero-or-more: a Policy nothing enforces is a rule kept by discipline." .

eos:requires a owl:ObjectProperty ;
    rdfs:domain eos:Skill ; rdfs:label "requires" .

eos:produces a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( eos:Skill eos:Workflow ) ] ;
    rdfs:range eos:Artifact ; rdfs:label "produces" .

eos:hasStep a owl:ObjectProperty ;
    rdfs:domain eos:Workflow ; rdfs:range eos:WorkflowStep ; rdfs:label "has step" ;
    rdfs:comment "UNORDERED, and the Workflow is still ordered: the order lives on WorkflowStep.hasPosition (ADR-0068)." .

eos:executes a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain eos:WorkflowStep ; rdfs:range eos:Skill ; rdfs:label "executes" .

eos:stepOf a owl:ObjectProperty , owl:FunctionalProperty ;
    owl:inverseOf eos:hasStep ; rdfs:label "step of" .

eos:passesThrough a owl:ObjectProperty ;
    rdfs:domain eos:Workflow ; rdfs:range eos:EngineeringGate ; rdfs:label "passes through" .

eos:governedBy a owl:ObjectProperty ;
    owl:inverseOf eos:governs ; rdfs:label "governed by" .

eos:reviews a owl:ObjectProperty ;
    rdfs:domain eos:EngineeringGate ; rdfs:label "reviews" .

eos:holds a owl:ObjectProperty ;
    rdfs:domain eos:EngineeringGate ; rdfs:label "holds" ;
    rdfs:comment "Range 'question' — NOT AN ENTITY. See FINDINGS.md #8." .

eos:decidedBy a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( eos:EngineeringGate eos:AcceptanceRecord ) ] ;
    rdfs:range eos:Actor ; rdfs:label "decided by" .

eos:accepts a owl:ObjectProperty ;
    rdfs:domain eos:AcceptanceRecord ; rdfs:range eos:ArtifactRevision ; rdfs:label "accepts" ;
    rdfs:comment "Acceptance confers Active status. Commits do not (ADR-0018, ADR-0020)." .

eos:reviewedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf eos:decidedBy ;
    rdfs:domain eos:AcceptanceRecord ; rdfs:range eos:Actor ; rdfs:label "reviewed by" ;
    rdfs:comment "Exactly one, and MUST NOT be the author. Self-certification is prohibited (ADR-0023) — and nothing yet enforces it." .

eos:cites a owl:ObjectProperty ;
    rdfs:domain eos:AcceptanceRecord ; rdfs:range eos:Evidence ; rdfs:label "cites" .

eos:supersedes a owl:ObjectProperty ;
    rdfs:domain eos:ADR ; rdfs:range eos:ADR ; rdfs:label "supersedes" .

eos:supersededBy a owl:ObjectProperty , owl:FunctionalProperty ;
    owl:inverseOf eos:supersedes ; rdfs:label "superseded by" .

eos:corrects a owl:ObjectProperty ;
    rdfs:domain eos:ADR ; rdfs:range eos:ADR ; rdfs:label "corrects" ;
    rdfs:comment "NOT supersedes. A correction fixes an error in an ADR whose decision remains Active. Six exist, all in a hand-maintained table (ISSUE-0048)." .

eos:resolves a owl:ObjectProperty ;
    rdfs:domain eos:ADR ; rdfs:range eos:Issue ; rdfs:label "resolves" .

eos:resolvedBy a owl:ObjectProperty ;
    owl:inverseOf eos:resolves ; rdfs:label "resolved by" .

eos:establishes a owl:ObjectProperty ;
    rdfs:domain eos:ADR ; rdfs:label "establishes" ;
    rdfs:comment "Range Principle — UNSPECIFIED entity. Never exercised: no Principle has been extracted from any of the 67 ADRs." .

eos:blocks a owl:ObjectProperty ;
    rdfs:domain eos:Issue ; rdfs:label "blocks" .

eos:defersTo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain eos:Issue ; rdfs:label "defers to" ;
    rdfs:comment "An unknown deliberately carried as debt to a named future point (ADR-0062). Nothing detects that the trigger has been met." .


###############################################################################
# Third increment — state machines, and the reification of ordering
###############################################################################

eos:StateMachineSpecification
    a owl:Class ;
    rdfs:subClassOf eos:DescriptiveEntity ;
    rdfs:label "State Machine Specification" ;
    rdfs:comment "Defines one state machine: states, transitions, and what it governs. Introduces LEGAL TRANSITION — the only construct in this metamodel that can express change over time; every other relationship is timeless. Every state belongs to exactly one machine (ADR-0025)." .

eos:StateMachine
    a owl:Class ;
    rdfs:subClassOf eos:DescriptiveEntity ;
    rdfs:label "State Machine" ;
    rdfs:comment "FAILS THE ADR-0067 TEST: introduces no relationship its specification does not already declare. Second confirmed merge candidate after Dimension, and the stronger of the two — nothing points at it. Retained pending ISSUE-0074." ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eos:specifiedByMachine ; owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .

eos:WorkflowStep
    a owl:Class ;
    rdfs:subClassOf eos:OperationalEntity ;
    rdfs:label "Workflow Step" ;
    rdfs:comment "The reified association between a Workflow and a Skill, carrying its position. Identity is (Workflow, position) — NOT (Workflow, Skill): a Workflow may execute the same Skill twice. Second reified association in the metamodel after DimensionAssignment." ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty eos:hasPosition ; owl:cardinality "1"^^xsd:nonNegativeInteger
    ] , [
        a owl:Restriction ; owl:onProperty eos:executes ; owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .

eos:specifiedByMachine a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain eos:StateMachine ; rdfs:range eos:StateMachineSpecification ;
    rdfs:label "specified by" ;
    rdfs:comment "The only relationship StateMachine has, and the one that makes it redundant." .

eos:governsType a owl:ObjectProperty ;
    rdfs:domain eos:StateMachineSpecification ; rdfs:range owl:Class ; rdfs:label "governs" ;
    rdfs:comment "One or more, not exactly one. ArtifactRevisionLifecycle governs revisions of every artifact type in the repository." .

eos:declaresStates a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain eos:StateMachineSpecification ; rdfs:label "declares states" ;
    rdfs:comment "Range Vocabulary — UNSPECIFIED entity." .

eos:declaresTransitions a owl:ObjectProperty ;
    rdfs:domain eos:StateMachineSpecification ; rdfs:label "declares transitions" ;
    rdfs:comment "Range 'transition rule' — NOT AN ENTITY. Under ADR-0068's test a transition is EXTRINSIC and should itself be a reified association." .

eos:drivenBy a owl:ObjectProperty ;
    rdfs:domain eos:StateMachineSpecification ; rdfs:range eos:Workflow ; rdfs:label "driven by" .

eos:hasPosition a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain eos:WorkflowStep ; rdfs:range xsd:integer ; rdfs:label "has position" ;
    rdfs:comment "EXTRINSIC ordering (ADR-0068): the same Skill holds different positions in different Workflows, so the position is a fact about the association. Contrast eos:directnessRank, which is INTRINSIC." .
