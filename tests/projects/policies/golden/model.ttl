@prefix ex:   <https://example.org/engineering-os/example#> .
@prefix eos:  <https://example.org/engineering-os/metamodel#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# A PROJECTION of the Canonical Knowledge Model (ADR-0072). Generated; do not edit.

<https://example.org/engineering-os/example> a owl:Ontology ;
    rdfs:comment "Layer B model expressed in the Layer A metamodel." ;
    owl:imports <https://example.org/engineering-os/metamodel> .

ex:Actor_Maintainer a eos:Actor ;
    rdfs:label "Maintainer" ;
    rdfs:comment "Decides." .

ex:Artifact_Change a eos:Artifact ;
    rdfs:label "A change" ;
    rdfs:comment "Reviewed." .

ex:Gate_Review a eos:EngineeringGate ;
    rdfs:label "Review gate" ;
    rdfs:comment "Holds the questions. Outcomes are a closed enumeration per gate." .

ex:Policy_ReviewBeforeMerge a eos:Policy ;
    rdfs:label "Review before merge" ;
    rdfs:comment "GovernancePolicy. Constrains normatively." .

ex:Workflow_Merge a eos:Workflow ;
    rdfs:label "Merge" ;
    rdfs:comment "Passes a gate." .

ex:Gate_Review eos:decidedBy ex:Actor_Maintainer .
ex:Gate_Review eos:reviews ex:Artifact_Change .
ex:Policy_ReviewBeforeMerge eos:governs ex:Workflow_Merge .
ex:Workflow_Merge eos:passesThrough ex:Gate_Review .
