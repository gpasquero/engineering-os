@prefix ex:   <https://example.org/engineering-os/example#> .
@prefix eos:  <https://example.org/engineering-os/metamodel#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# A PROJECTION of the Canonical Knowledge Model (ADR-0072). Generated; do not edit.

<https://example.org/engineering-os/example> a owl:Ontology ;
    rdfs:comment "Layer B model expressed in the Layer A metamodel." ;
    owl:imports <https://example.org/engineering-os/metamodel> .

ex:ADR_New a eos:ADR ;
    rdfs:label "The replacing decision" ;
    rdfs:comment "Replaces the old one." .

ex:ADR_Old a eos:ADR ;
    rdfs:label "A superseded decision" ;
    rdfs:comment "Superseded, and still readable." .

ex:Artifact_Stale a eos:Artifact ;
    rdfs:label "An implementation of a superseded rationale" ;
    rdfs:comment "Three hops from the supersession that invalidates its reason." .

ex:Concept_Rationale a eos:Concept ;
    rdfs:label "A concept established by the old decision" ;
    rdfs:comment "Its reason no longer stands." .

ex:ADR_Old eos:establishes ex:Concept_Rationale .
ex:ADR_Old eos:supersededBy ex:ADR_New .
ex:Artifact_Stale eos:represents ex:Concept_Rationale .
