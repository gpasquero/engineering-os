    {
      "id": "Concept.FieldManagement",
      "type": "Concept",
      "label": "Field management",
      "family": "descriptive",
      "position": null,
      "description": "\"The user relies on and expects the value of the field not to change. The user\nwho last made an assertion about the value of a field will be recorded as the\ncurrent field manager.\"",
