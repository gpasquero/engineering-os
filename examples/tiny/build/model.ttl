ex:ArtifactRevision_CheckoutService_r2 a eos:ArtifactRevision ;
    rdfs:label "Checkout service r2" ;
    rdfs:comment "The unit that carries lifecycle state and the unit that is accepted." .

ex:BoundedContext_Sales a eos:BoundedContext ;
    rdfs:label "Sales" ;
    rdfs:comment "The boundary within which 'Order' means a customer's purchase request." .

ex:Capability_PlaceOrder a eos:Capability ;
    rdfs:label "Place an order" ;
