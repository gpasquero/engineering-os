    rdfs:comment "Check that an order references known goods and a reachable customer." .

ex:Workflow_Checkout a eos:Workflow ;
    rdfs:label "Checkout" ;
    rdfs:comment "Orchestration only. Holds no methodology of its own." .

ex:WorkflowStep_Checkout_1 a eos:WorkflowStep ;
