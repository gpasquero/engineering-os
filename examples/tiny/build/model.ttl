ex:ADR_0001 a eos:ADR ;
    rdfs:label "Verify payment synchronously at checkout" ;
    rdfs:comment "Decision with alternatives considered. Never edited once accepted; superseded." .

ex:Artifact_CheckoutService a eos:Artifact ;
