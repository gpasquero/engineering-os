ex:AcceptanceRecord_0001 a eos:AcceptanceRecord ;
    rdfs:label "Acceptance of checkout service r2" ;
    rdfs:comment "The act that confers Active status. Commits do not." .

ex:Actor_Customer a eos:Actor ;
